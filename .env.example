# ─────────────────────────────────────────────────────────────────────────────
# SpeakQuest AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — backend ONLY, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT secret — used to verify Supabase JWTs on the Python backend
# Get from: Supabase → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── LLM — Primary: Gemma via Google AI Studio ────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMMA_API_KEY=your-google-ai-api-key

# Optional: override model from model.yaml at runtime
# GEMMA_MODEL=gemma-3-27b-it

# ── LLM — Fallback: Ollama (local, no key needed) ────────────────────────────
# Ensure Ollama is running: `ollama serve`
# Pull the model first: `ollama pull gemma3:12b`
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:12b

# ── Speech-to-Text: Groq Whisper ─────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Comma-separated list of allowed origins for CORS
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# URL of the Python FastAPI backend (called from Next.js server-side)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TRANSCRIBE_PER_MINUTE=10
RATE_LIMIT_EVALUATE_PER_MINUTE=5
RATE_LIMIT_SESSIONS_PER_MINUTE=20

# ── Security ──────────────────────────────────────────────────────────────────
# Maximum audio upload size in bytes (default: 25 MB)
MAX_AUDIO_UPLOAD_BYTES=26214400

# ── Optional: LangSmith tracing (for debugging LangChain/LangGraph) ──────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=speakquest-dev
